<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.salud_y_vida">

    <!-- Permiso para consumir la API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salud_y_Vida"
        android:usesCleartextTraffic="true"
        tools:targetApi="31"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Pantalla de bienvenida -->
        <activity
            android:name=".ui.login.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Salud_y_Vida">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Login -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Salud_y_Vida" />

        <!-- Dashboard -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="true"
            android:theme="@style/Theme.Salud_y_Vida" />

        <!-- Pacientes -->
        <activity
            android:name=".ui.p_paciente.list.PacienteListActivity"
            android:exported="true"
            android:theme="@style/Theme.Salud_y_Vida" />
        <activity
            android:name=".ui.p_paciente.addon.PacienteActivity"
            android:exported="true"/>
        <activity
            android:name=".ui.p_paciente.info.PacienteInfoActivity"
            android:exported="true" />


        <!-- Cita -->
        <activity android:name=".ui.p_cita.list.CitaListActivity"
                    android:exported="true"
                    android:theme="@style/Theme.Salud_y_Vida" />
        <activity
            android:name=".ui.p_cita.addon.CitaMedicaActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".ui.p_cita.info.CitaMedicaInfoActivity"
            android:exported="true" />
        <!--Medicos-->
        <activity android:name=".ui.p.medico.list.MedicoListActivity"
            android:exported="true"
            android:theme="@style/Theme.Salud_y_Vida"/>

        <activity
            android:name=".IngresoMedicamentoActivity"
            android:exported="true">

        </activity>

    </application>

</manifest>