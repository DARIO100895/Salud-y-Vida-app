<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base con Material 3 -->
    <style name="Base.Theme.Salud_y_Vida" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Colores principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_light</item>
        <item name="colorOnSecondaryContainer">@color/black</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/tertiary_light</item>
        <item name="colorOnTertiaryContainer">@color/black</item>


        <!-- Fondo y superficie -->
        <item name="background">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_secondary</item>


        <!-- Ripple y control -->
        <item name="colorControlHighlight">@color/primary_light</item>
        <item name="colorControlActivated">@color/primary</item>
    </style>

    <!-- Tema principal que hereda del base -->
    <style name="Theme.Salud_y_Vida" parent="Base.Theme.Salud_y_Vida" />

</resources>