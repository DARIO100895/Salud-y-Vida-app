<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_list"
        android:scaleType="centerCrop" />

    <!-- Contenido principal -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

    <!-- BARRA DE BÚSQUEDA -->
    <SearchView
        android:id="@+id/searchEspecialidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Buscar especialidad..."
        android:iconifiedByDefault="false"
        android:background="@drawable/searchview_background"
        android:padding="8dp" />

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEspecialidad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- BOTÓN ATRÁS (izquierda) + FAB (derecha) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:text="Atrás"
            android:textColor="@color/secondary_dark"
            android:textSize="16dp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface"
            app:icon="@drawable/ic_arrow_back"
            app:iconTintMode="add"
            app:iconTint="@color/secondary_dark" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/surface" />
    </RelativeLayout>
    </LinearLayout>
</FrameLayout>